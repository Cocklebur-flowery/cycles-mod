+void GraphicsInteropBuffer::assign_timeline_semaphore(const int64_t handle)
+{
+  assert(handle != 0 && timeline_semaphore_handle_ == 0);
+  timeline_semaphore_handle_ = handle;
+  own_timeline_semaphore_handle_ = true;
+}
+
+void GraphicsInteropBuffer::set_timeline_signal_value(const uint64_t value)
+{
+  timeline_signal_value_ = value;
+}
+
+uint64_t GraphicsInteropBuffer::get_timeline_signal_value() const
+{
+  return timeline_signal_value_;
+}
+
+bool GraphicsInteropBuffer::has_timeline_semaphore() const
+{
+  return timeline_semaphore_handle_ != 0;
+}
+
+bool GraphicsInteropBuffer::has_new_timeline_semaphore() const
+{
+  return own_timeline_semaphore_handle_;
+}
+
+int64_t GraphicsInteropBuffer::take_timeline_semaphore()
+{
+  assert(own_timeline_semaphore_handle_);
+  own_timeline_semaphore_handle_ = false;
+  return timeline_semaphore_handle_;
+}
