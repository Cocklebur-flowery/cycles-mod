+void device_memory::device_copy_to(const size_t offset, const size_t size)
+{
+  assert(offset <= memory_size() && size <= memory_size() - offset);
+  if (!host_pointer || size == 0) {
+    return;
+  }
+
+  copy_offset_ = offset;
+  copy_size_ = size;
+  try {
+    device->mem_copy_to(*this);
+  }
+  catch (...) {
+    copy_offset_ = 0;
+    copy_size_ = 0;
+    throw;
+  }
+  copy_offset_ = 0;
+  copy_size_ = 0;
+}
+
 void device_memory::device_move_to_host()
 {
   if (host_pointer) {
     device->mem_move_to_host(*this);
   }
