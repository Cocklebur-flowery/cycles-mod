@@ -1081,6 +1081,8 @@ bool PathTraceWorkGPU::copy_to_display_interop(PathTraceDisplay *display,
 
   GraphicsInteropBuffer &interop_buffer = display->graphics_interop_get_buffer();
   device_graphics_interop_->set_buffer(interop_buffer);
+  const bool synchronize_vulkan =
+      interop_buffer.get_type() == GraphicsInteropDevice::VULKAN;
 
