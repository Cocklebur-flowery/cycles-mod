#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
message_file=${1:?Git did not provide a commit message file}
validator="$repo_root/scripts/validate-commit-message.py"

if command -v python3 >/dev/null 2>&1; then
    python3 "$validator" --message-file "$message_file"
elif command -v python >/dev/null 2>&1; then
    python "$validator" --message-file "$message_file"
elif command -v py >/dev/null 2>&1; then
    py -3 "$validator" --message-file "$message_file"
else
    echo "Cycles Renderer commit rejected: Python 3 is required by the tracked commit validator." >&2
    exit 1
fi
