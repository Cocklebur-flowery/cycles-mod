+    depth_access.use_sample_count = false;
+    PassAccessor::Destination depth_destination(PASS_DEPTH, PassMode::NOISY);
+    depth_destination.d_pixels = d_rgba_half + color_bytes;
+    const PassAccessorGPU depth_accessor(queue_.get(), depth_access, 1.0f, num_samples);
+    depth_accessor.get_render_tile_pixels(
+        buffers_.get(), effective_buffer_params_, depth_destination);
+  }
+
   device_graphics_interop_->unmap();
 
