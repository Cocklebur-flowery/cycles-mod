+void GraphicsInteropBuffer::set_range(const size_t offset, const size_t size)
+{
+  assert(offset <= size_ && size <= size_ - offset);
+  offset_ = offset;
+  range_size_ = size;
+}
+
+size_t GraphicsInteropBuffer::get_offset() const
+{
+  return offset_;
+}
+
+size_t GraphicsInteropBuffer::get_range_size() const
