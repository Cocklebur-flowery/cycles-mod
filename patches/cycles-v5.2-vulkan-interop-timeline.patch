+void GraphicsInteropBuffer::assign_timeline_semaphores(const int64_t ready_handle,
+                                                       const int64_t release_handle)
+{
+  assert(ready_handle != 0 && release_handle != 0);
+  assert(ready_timeline_semaphore_handle_ == 0 && release_timeline_semaphore_handle_ == 0);
+  ready_timeline_semaphore_handle_ = ready_handle;
+  release_timeline_semaphore_handle_ = release_handle;
+  own_ready_timeline_semaphore_handle_ = true;
+  own_release_timeline_semaphore_handle_ = true;
+}
+
+void GraphicsInteropBuffer::set_timeline_values(const uint64_t ready_signal_value,
+                                                const uint64_t release_wait_value)
+{
+  ready_signal_value_ = ready_signal_value;
+  release_wait_value_ = release_wait_value;
+}
+
+uint64_t GraphicsInteropBuffer::get_ready_signal_value() const
+{
+  return ready_signal_value_;
+}
+
+uint64_t GraphicsInteropBuffer::get_release_wait_value() const
+{
+  return release_wait_value_;
+}
+
+bool GraphicsInteropBuffer::has_timeline_semaphores() const
+{
+  return ready_timeline_semaphore_handle_ != 0 && release_timeline_semaphore_handle_ != 0;
+}
+
+bool GraphicsInteropBuffer::has_new_timeline_semaphores() const
+{
+  return own_ready_timeline_semaphore_handle_ && own_release_timeline_semaphore_handle_;
+}
+
+int64_t GraphicsInteropBuffer::take_ready_timeline_semaphore()
+{
+  assert(own_ready_timeline_semaphore_handle_);
+  own_ready_timeline_semaphore_handle_ = false;
+  return ready_timeline_semaphore_handle_;
+}
+
+int64_t GraphicsInteropBuffer::take_release_timeline_semaphore()
+{
+  assert(own_release_timeline_semaphore_handle_);
+  own_release_timeline_semaphore_handle_ = false;
+  return release_timeline_semaphore_handle_;
+}
+
 bool GraphicsInteropBuffer::has_new_handle() const
 {
   return own_handle_;
