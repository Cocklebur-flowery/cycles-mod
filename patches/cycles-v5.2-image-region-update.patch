+void device_image::copy_region_to_device(const size_t x,
+                                         const size_t y,
+                                         const size_t width,
+                                         const size_t height)
+{
+  assert(x <= data_width && width <= data_width - x);
+  assert(y <= data_height && height <= data_height - y);
+  if (width == 0 || height == 0 || device_is_cpu()) {
+    return;
+  }
+
+  const size_t pixel_size = datatype_size(data_type) * data_elements;
+  const size_t row_size = width * pixel_size;
+  for (size_t row = 0; row < height; row++) {
+    const size_t offset = ((y + row) * data_width + x) * pixel_size;
+    device_copy_to(offset, row_size);
+  }
+}
