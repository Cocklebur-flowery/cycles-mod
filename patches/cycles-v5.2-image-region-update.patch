+static CUDA_MEMCPY2D tex_2d_copy_param(const device_image &mem,
+                                       const int pitch_alignment,
+                                       const size_t byte_offset,
+                                       const size_t byte_count)
+{
+  const size_t src_pitch = tex_src_pitch(mem);
+  const size_t dst_pitch = align_up(src_pitch, pitch_alignment);
+  const size_t x = byte_offset % src_pitch;
+  const size_t y = byte_offset / src_pitch;
+  assert(byte_count <= src_pitch - x);
+  assert(y < mem.data_height);
+
+  CUDA_MEMCPY2D param = tex_2d_copy_param(mem, pitch_alignment);
+  param.dstDevice += y * dst_pitch + x;
+  param.srcHost = static_cast<const char *>(mem.host_pointer) + byte_offset;
+  param.WidthInBytes = byte_count;
+  param.Height = 1;
+  return param;
+}
