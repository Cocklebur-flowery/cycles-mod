+bool ImageManager::update_image_region(const ImageHandle &handle,
+                                       const int x,
+                                       const int y,
+                                       const int width,
+                                       const int height,
+                                       const uint8_t *pixels,
+                                       const size_t row_stride)
+{
+  if (handle.manager != this || handle.image_texture == nullptr || pixels == nullptr || x < 0 ||
+      y < 0 || width <= 0 || height <= 0 || handle.image_texture->type != ImageTexture::SINGLE)
+  {
+    return false;
+  }
+
+  const thread_scoped_lock images_lock(images_mutex);
+  ImageSingle *image = static_cast<ImageSingle *>(handle.image_texture);
+  const thread_scoped_lock image_lock(image->mutex);
+  if (image->need_load || image->vdb_memory == nullptr ||
+      image->metadata.type != IMAGE_DATA_TYPE_BYTE4 || image->metadata.channels != 4 ||
+      x > image->metadata.width || width > image->metadata.width - x ||
+      y > image->metadata.height || height > image->metadata.height - y ||
+      row_stride < size_t(width) * 4 ||
+      image->vdb_memory->data_width != size_t(image->metadata.width) ||
+      image->vdb_memory->data_height != size_t(image->metadata.height))
+  {
+    return false;
+  }
+
+  vector<uint8_t> conformed(size_t(width) * height * 4);
+  for (int row = 0; row < height; row++) {
+    std::memcpy(conformed.data() + size_t(row) * width * 4,
+                pixels + size_t(row) * row_stride,
+                size_t(width) * 4);
+  }
+  image->metadata.conform_pixels(
+      conformed.data(), width, height, 4, size_t(width) * 4, size_t(width) * 4);
+
+  uint8_t *target = image->vdb_memory->data<uint8_t>();
+  for (int row = 0; row < height; row++) {
+    std::memcpy(target + (size_t(y + row) * image->metadata.width + x) * 4,
+                conformed.data() + size_t(row) * width * 4,
+                size_t(width) * 4);
+  }
+  image->vdb_memory->copy_region_to_device(x, y, width, height);
+  return true;
+}
